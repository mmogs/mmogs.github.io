body {
  font-family: Arial;
  text-align: center;
  margin-top: 50px;
  background: #f4f4f4;
}

.card {
  background: white;
  padding: 20px;
  border-radius: 10px;
  width: 250px;
  margin: auto;
  box-shadow: 0 4px 10px rgba(0,0,0,0.1);
}

input {
  width: 80%;
  padding: 8px;
  margin: 5px 0;
  font-size: 16px;
}

#result {
  margin-top: 15px;
  font-weight: bold;
}